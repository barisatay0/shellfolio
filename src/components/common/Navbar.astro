---
import { Database, Briefcase, Code, GraduationCap, Globe, UserCircle, Sun, Moon } from "lucide-astro";
import { siteConfig } from "../../config/site";
import {
    getLangFromUrl,
    useTranslations,
    getRouteWithLang,
} from "../../i18n/utils";
import { ui, defaultLang } from "../../i18n/ui";

const currentPath = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links: {
    path: string;
    key: keyof (typeof ui)[typeof defaultLang];
    icon: any;
}[] = [
    { path: "", key: "nav.dashboard", icon: UserCircle },
    { path: "experience", key: "nav.experience", icon: Briefcase },
    { path: "projects", key: "nav.projects", icon: Database },
    { path: "skills", key: "nav.skills", icon: Code },
    { path: "education", key: "nav.education", icon: GraduationCap },
];
---

<nav
    class="w-full md:w-64 h-auto md:h-full bg-white/80 dark:bg-white/[0.01] border-b md:border-b-0 md:border-r border-slate-200/80 dark:border-white/5 backdrop-blur-xl flex flex-col z-20 shrink-0 shadow-sm dark:shadow-2xl relative transition-colors duration-300"
>
    <!-- Top profile area -->
    <div class="p-8 border-b border-slate-200/80 dark:border-white/5 hidden md:flex flex-col items-center text-center">
        <div class="w-20 h-20 rounded-full border-2 border-green-500/20 p-1 mb-4 relative group">
            <div class="absolute inset-0 bg-green-500/20 blur-xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <img 
                src={siteConfig.developer.avatar} 
                alt={siteConfig.developer.name} 
                class="w-full h-full rounded-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-500"
            />
        </div>
        <h2 class="text-slate-900 dark:text-white font-bold text-lg">{siteConfig.developer.name}</h2>
        <p class="text-green-600 dark:text-green-400 text-xs font-medium uppercase tracking-wider mt-1">{siteConfig.developer.role[lang as "en" | "tr"]}</p>
    </div>

    <!-- Navigation links -->
    <ul class="flex-1 overflow-y-auto p-4 space-y-1 flex flex-row md:flex-col justify-around md:justify-start custom-scrollbar">
        {
            links.map((link) => {
                const Icon = link.icon;
                const linkPath = link.path === "" ? `/${lang}` : `/${lang}/${link.path}`;
                const isActive = currentPath === linkPath || currentPath === linkPath + "/";

                return (
                    <li>
                        <a
                            href={linkPath}
                            aria-label={t(link.key)}
                            class={`flex items-center gap-3 px-4 py-3 md:py-3.5 rounded-xl text-sm transition-all duration-300 relative group overflow-hidden ${
                                isActive
                                    ? "text-slate-900 dark:text-white bg-slate-200/60 dark:bg-white/[0.05] border border-slate-300/80 dark:border-white/[0.08]"
                                    : "text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/[0.02]"
                            }`}
                        >
                            {isActive && (
                                <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-1/2 bg-green-500 rounded-r-full shadow-[0_0_10px_rgba(34,197,94,0.5)]"></div>
                            )}
                            <Icon size={18} class={`transition-transform duration-300 ${isActive ? "text-green-600 dark:text-green-400 scale-110" : "group-hover:scale-110"}`} />
                            <span class="hidden md:inline font-medium">{t(link.key)}</span>
                        </a>
                    </li>
                );
            })
        }
    </ul>

    <!-- Bottom actions -->
    <div class="p-4 md:p-6 border-t border-slate-200/80 dark:border-white/5 mt-0 md:mt-auto flex items-center justify-center md:justify-start bg-slate-100/50 dark:bg-black/20">
        <div class="flex items-center gap-2 text-xs font-medium w-full justify-between">
            <div class="flex items-center gap-1 bg-slate-200/60 dark:bg-white/[0.03] p-1 rounded-lg border border-slate-300/80 dark:border-white/5">
                <Globe size={14} class="text-slate-500 ml-1 hidden sm:block" />
                <a
                    href={getRouteWithLang(Astro.url, "en")}
                    data-lang="en"
                    class={`lang-btn px-2.5 py-1.5 rounded-md transition-all duration-300 ${lang === "en" ? "bg-white dark:bg-white/10 text-slate-900 dark:text-white font-semibold shadow-sm" : "text-slate-500 hover:text-slate-900 dark:hover:text-slate-300"}`}
                >
                    EN
                </a>
                <a
                    href={getRouteWithLang(Astro.url, "tr")}
                    data-lang="tr"
                    class={`lang-btn px-2.5 py-1.5 rounded-md transition-all duration-300 ${lang === "tr" ? "bg-white dark:bg-white/10 text-slate-900 dark:text-white font-semibold shadow-sm" : "text-slate-500 hover:text-slate-900 dark:hover:text-slate-300"}`}
                >
                    TR
                </a>
            </div>

            <!-- Theme Toggle Button -->
            <button
                id="theme-toggle"
                type="button"
                aria-label={t("theme.toggle")}
                title={t("theme.toggle")}
                class="p-2 rounded-lg bg-slate-200/60 dark:bg-white/[0.03] border border-slate-300/80 dark:border-white/5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-all duration-300 cursor-pointer flex items-center justify-center hover:scale-105 active:scale-95"
            >
                <Sun size={16} class="hidden dark:block text-amber-400" />
                <Moon size={16} class="block dark:hidden text-slate-700" />
            </button>
        </div>
    </div>
</nav>

<script>
    function setupNavControls() {
        document.querySelectorAll('.lang-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                const lang = btn.getAttribute('data-lang');
                if (lang) {
                    try {
                        localStorage.setItem('preferred_lang', lang);
                    } catch (e) {}
                }
            });
        });

        const toggleBtn = document.getElementById('theme-toggle');
        if (toggleBtn) {
            toggleBtn.onclick = () => {
                const isDark = document.documentElement.classList.contains('dark');
                if (isDark) {
                    document.documentElement.classList.remove('dark');
                    try {
                        localStorage.setItem('theme', 'light');
                    } catch (e) {}
                } else {
                    document.documentElement.classList.add('dark');
                    try {
                        localStorage.setItem('theme', 'dark');
                    } catch (e) {}
                }
            };
        }
    }

    setupNavControls();
    document.addEventListener('astro:after-swap', setupNavControls);
</script>
